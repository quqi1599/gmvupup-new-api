{
  "openapi": "3.0.3",
  "info": {
    "title": "GMVUPUP API",
    "version": "1.2.0",
    "description": "GMVUPUP model discovery, image, chat and native Doubao Seedance video APIs."
  },
  "servers": [
    {
      "url": "https://gmvupup.top"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SeedanceRequest": {
        "type": "object",
        "required": [
          "model",
          "content"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "doubao-seedance-2.5",
              "doubao-seedance-2.0"
            ]
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            },
            "description": "Use an item of type text for a prompt. Reference media must use a native content type supported by the model."
          },
          "duration": {
            "type": "integer",
            "description": "Output duration in whole seconds. Supported values depend on the model and task type."
          },
          "resolution": {
            "type": "string",
            "description": "Choose an output resolution supported by your model."
          },
          "ratio": {
            "type": "string"
          },
          "generate_audio": {
            "type": "boolean"
          }
        }
      },
      "VideoTask": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Public GMVUPUP task ID from the response body."
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "expired",
              "cancelled"
            ]
          },
          "content": {
            "type": "object",
            "properties": {
              "video_url": {
                "type": "string",
                "format": "uri",
                "description": "Temporary signed output URL. Download without a GMVUPUP API key."
              },
              "last_frame_url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "completion_tokens": {
                "type": "integer"
              },
              "total_tokens": {
                "type": "integer"
              }
            }
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/v1/models": {
      "get": {
        "operationId": "models",
        "summary": "Model directory",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/v1/images/generations": {
      "post": {
        "operationId": "images",
        "summary": "Image generation",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "n": {
                    "type": "integer"
                  },
                  "size": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "model": "gpt-image-2.6",
                "prompt": "A lavender sneaker on pale sand, soft studio lighting.",
                "n": 1,
                "size": "1024x1024"
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "chat",
        "summary": "Chat completions",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "stream": {
                    "type": "boolean"
                  }
                }
              },
              "example": {
                "model": "deepseek-v4.1-flash",
                "messages": [
                  {
                    "role": "user",
                    "content": "Write three short headlines for a new running shoe."
                  }
                ],
                "stream": false
              }
            }
          }
        }
      }
    },
    "/v1/images/edits": {
      "post": {
        "operationId": "image_edits",
        "summary": "Edit an image",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "image",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "gpt-image-2.6"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "n": {
                    "type": "integer",
                    "default": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        }
      }
    },
    "/doubao/api/v3/contents/generations/tasks": {
      "post": {
        "operationId": "createSeedanceVideo",
        "summary": "Create a Seedance 2.5 or 2.0 video task",
        "description": "Submit a native Doubao video task. Save the public id from the JSON body. Final charges use reported video token usage. After a timeout, check for a task before resubmitting.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedanceRequest"
              },
              "example": {
                "model": "doubao-seedance-2.5",
                "content": [
                  {
                    "type": "text",
                    "text": "A white cup on a table. The camera slowly pushes in."
                  }
                ],
                "duration": 5,
                "resolution": "480p",
                "ratio": "16:9",
                "generate_audio": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted. Use the id in the JSON body to query it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoTask"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or rejected task"
          },
          "401": {
            "description": "Invalid or missing GMVUPUP API key"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/doubao/api/v3/contents/generations/tasks/{task_id}": {
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "GMVUPUP task ID returned in the JSON body of the submit request."
        }
      ],
      "get": {
        "operationId": "getSeedanceVideo",
        "summary": "Query a video task",
        "description": "Poll about every 10 seconds while queued or running. When succeeded, use content.video_url.",
        "responses": {
          "200": {
            "description": "Current task state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoTask"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or rejected task"
          },
          "401": {
            "description": "Invalid or missing GMVUPUP API key"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    }
  }
}
