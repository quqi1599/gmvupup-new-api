{
  "openapi": "3.0.3",
  "info": {
    "title": "GMVUPUP API",
    "version": "1.1.0",
    "description": "GMVUPUP image, chat and Seedance video APIs. Seedance uses the custom JSON fields documented here, not OpenAI video SDK parameters."
  },
  "servers": [
    {
      "url": "https://gmvupup.top/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SeedanceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "userPrompt",
          "duration",
          "quality",
          "aspectRatio"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "doubao-seedance-2.5",
              "doubao-seedance-2.0"
            ]
          },
          "userPrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000,
            "pattern": "\\S"
          },
          "duration": {
            "type": "integer",
            "minimum": 4,
            "maximum": 15
          },
          "quality": {
            "type": "string",
            "enum": [
              "480p",
              "720p",
              "1080p"
            ]
          },
          "aspectRatio": {
            "type": "string",
            "enum": [
              "21:9",
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16"
            ]
          },
          "firstImageUrl": {
            "type": "string",
            "maxLength": 8192,
            "description": "Absolute HTTP(S) URL or authorized asset://asset_ID. No local paths or Base64."
          },
          "lastImageUrl": {
            "type": "string",
            "maxLength": 8192,
            "description": "Absolute HTTP(S) URL or authorized asset://asset_ID. No local paths or Base64."
          },
          "generateAudio": {
            "type": "boolean"
          },
          "returnLastFrame": {
            "type": "boolean"
          },
          "seed": {
            "type": "integer",
            "minimum": -1,
            "maximum": 4294967295
          },
          "bitrateMode": {
            "type": "string",
            "enum": [
              "standard",
              "high"
            ]
          },
          "refImageUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 8192,
              "description": "Absolute HTTP(S) URL or authorized asset://asset_ID. No local paths or Base64."
            },
            "maxItems": 9
          },
          "refAudioUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 8192,
              "description": "Absolute HTTP(S) URL or authorized asset://asset_ID. No local paths or Base64."
            },
            "maxItems": 3
          },
          "refVideoUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 8192,
              "description": "Absolute HTTP(S) URL or authorized asset://asset_ID. No local paths or Base64."
            },
            "maxItems": 3
          }
        },
        "description": "The combined firstImageUrl, lastImageUrl and refImageUrls count must not exceed 9. Fields prompt, seconds, size and multipart are not supported."
      },
      "VideoTask": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "enum": [
              "video"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "in_progress",
              "completed",
              "failed"
            ]
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "url": {
            "type": "string",
            "description": "Relative authenticated video content path, available after completed."
          },
          "lastFrameUrl": {
            "type": "string",
            "description": "Relative authenticated last-frame content path, when requested and available."
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/models": {
      "get": {
        "operationId": "models",
        "summary": "Model directory",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/images/generations": {
      "post": {
        "operationId": "images",
        "summary": "Image generation",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "n": {
                    "type": "integer"
                  },
                  "size": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "model": "gpt-image-2.6",
                "prompt": "A lavender sneaker on pale sand, soft studio lighting.",
                "n": 1,
                "size": "1024x1024"
              }
            }
          }
        }
      }
    },
    "/chat/completions": {
      "post": {
        "operationId": "chat",
        "summary": "Chat completions",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "stream": {
                    "type": "boolean"
                  }
                }
              },
              "example": {
                "model": "deepseek-v4.1-flash",
                "messages": [
                  {
                    "role": "user",
                    "content": "Write three short headlines for a new running shoe."
                  }
                ],
                "stream": false
              }
            }
          }
        }
      }
    },
    "/images/edits": {
      "post": {
        "operationId": "image_edits",
        "summary": "Edit an image",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "image",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "gpt-image-2.6"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "n": {
                    "type": "integer",
                    "default": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        }
      }
    },
    "/videos": {
      "post": {
        "operationId": "createSeedanceVideo",
        "summary": "Create a Seedance 2.5 or 2.0 video task",
        "description": "Charged per output second at the configured resolution rate. Save the returned id. Do not automatically repeat a timed-out submission.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedanceRequest"
              },
              "example": {
                "model": "doubao-seedance-2.5",
                "userPrompt": "A sneaker floating above lilac dunes, slow camera movement.",
                "duration": 5,
                "quality": "720p",
                "aspectRatio": "16:9"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted or current task state; queued is not completion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoTask"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or rejected task"
          },
          "401": {
            "description": "Invalid or missing GMVUPUP API key"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/videos/{task_id}": {
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "GMVUPUP task id returned by POST /videos, owned by this API key account."
        }
      ],
      "get": {
        "operationId": "getSeedanceVideo",
        "summary": "Query a video task",
        "description": "Poll about every 10 seconds until completed or failed.",
        "responses": {
          "200": {
            "description": "Task accepted or current task state; queued is not completion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoTask"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or rejected task"
          },
          "401": {
            "description": "Invalid or missing GMVUPUP API key"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    },
    "/videos/{task_id}/content": {
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "GMVUPUP task id returned by POST /videos, owned by this API key account."
        }
      ],
      "get": {
        "operationId": "getSeedanceVideoContent",
        "summary": "Download Video content",
        "description": "Requires the same GMVUPUP API key. Only available after task completion; last frame additionally requires a returned lastFrameUrl.",
        "responses": {
          "200": {
            "description": "Content is available",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Requested partial content"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Task or artifact not found"
          },
          "409": {
            "description": "Artifact not ready"
          }
        }
      },
      "head": {
        "operationId": "headSeedanceVideoContent",
        "summary": "Inspect Video content",
        "description": "Requires the same GMVUPUP API key. Only available after task completion; last frame additionally requires a returned lastFrameUrl.",
        "responses": {
          "200": {
            "description": "Content is available"
          },
          "206": {
            "description": "Requested partial content"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Task or artifact not found"
          },
          "409": {
            "description": "Artifact not ready"
          }
        }
      }
    },
    "/tasks/{task_id}/artifacts/last_frame/content": {
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "GMVUPUP task id returned by POST /videos, owned by this API key account."
        }
      ],
      "get": {
        "operationId": "getSeedanceLastFrameContent",
        "summary": "Download LastFrame content",
        "description": "Requires the same GMVUPUP API key. Only available after task completion; last frame additionally requires a returned lastFrameUrl.",
        "responses": {
          "200": {
            "description": "Content is available",
            "content": {
              "image/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Requested partial content"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Task or artifact not found"
          },
          "409": {
            "description": "Artifact not ready"
          }
        }
      },
      "head": {
        "operationId": "headSeedanceLastFrameContent",
        "summary": "Inspect LastFrame content",
        "description": "Requires the same GMVUPUP API key. Only available after task completion; last frame additionally requires a returned lastFrameUrl.",
        "responses": {
          "200": {
            "description": "Content is available"
          },
          "206": {
            "description": "Requested partial content"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Task or artifact not found"
          },
          "409": {
            "description": "Artifact not ready"
          }
        }
      }
    }
  }
}
